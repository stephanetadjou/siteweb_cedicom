APP_NAME="CEDICOM Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données ---
# En local : SQLite (fichier database/database.sqlite)
DB_CONNECTION=sqlite

# En production : MySQL. Commenter la ligne DB_CONNECTION=sqlite ci-dessus,
# puis décommenter et compléter ce bloc (voir README_DEPLOIEMENT.md).
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cedicom_site
# DB_USERNAME=cedicom
# DB_PASSWORD=mot_de_passe_solide

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mails ---
# En local : les e-mails sont écrits dans storage/logs/laravel.log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# En production : SMTP de l'hébergeur (boîte créée dans cPanel). Remplacer le bloc
# ci-dessus par celui-ci. MAIL_FROM_ADDRESS doit être identique à MAIL_USERNAME.
# Port 465 (SSL) : MAIL_SCHEME=smtps. Port 587 (TLS) : MAIL_SCHEME=smtp.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=mail.cedicomgroup.com
# MAIL_PORT=465
# MAIL_USERNAME=info@cedicomgroup.com
# MAIL_PASSWORD=mot_de_passe_de_la_boite
# MAIL_FROM_ADDRESS="info@cedicomgroup.com"
# MAIL_FROM_NAME="CEDICOM Group"

# Destinataires des alertes de formulaires (adresses séparées par des virgules).
MAIL_NOTIFY_TO=info@cedicomgroup.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
